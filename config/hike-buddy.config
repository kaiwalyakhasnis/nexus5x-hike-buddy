# Hike Buddy diet, merged on top of bullhead_defconfig by scripts/build-kernel.sh.
# Rule: drop whole subsystems the console never uses, and debug features
# that cost CPU at runtime. Keep MDSS/WLED, PMI8994 charger+FG, RTC, PIL/MSS,
# SMD/IPC router/QMI (GPS), nanohub, keys, haptics, RGB LED, touch, USB gadget.

# --- no Android userspace
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_ASHMEM is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SDCARD_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_EXT4_FS_ENCRYPTION is not set
# CONFIG_QUOTA is not set
# no ueventd: let the kernel populate /dev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- camera, video, GPU, audio
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_MSMB_CAMERA is not set
# CONFIG_MSM_VIDC_V4L2 is not set
# CONFIG_MSM_KGSL is not set
# ALSA core stays: the android gadget links f_midi/f_audio_source unconditionally.
# Only the SoC/codec/USB-audio drivers go.
# CONFIG_SND_SOC is not set
# CONFIG_SND_USB_AUDIO is not set
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_CAIAQ is not set
# CONFIG_SND_USB_6FIRE is not set
# CONFIG_WCD9330_CODEC is not set
# CONFIG_SLIMBUS_MSM_NGD is not set
# CONFIG_MSM_AVTIMER is not set
# CONFIG_MSM_ADSPRPC is not set
# CONFIG_MSM_ADSP_LOADER is not set
# CONFIG_SENSORS_SSC is not set
# CONFIG_MSM_QDSP6V2_CODECS is not set
# CONFIG_MSM_QDSP6_APRV2 is not set
# CONFIG_STMVL6180 is not set
# CONFIG_FB_MSM_MDSS_WRITEBACK is not set
# CONFIG_LEDS_QPNP_FLASH is not set

# --- radios other than the modem (GPS lives in the modem)
# CONFIG_BT is not set
# CONFIG_CFG80211 is not set
# CONFIG_QCA_CLD_WLAN is not set
# CONFIG_WLAN is not set
# CONFIG_CNSS is not set
# CONFIG_WCNSS_MEM_PRE_ALLOC is not set
# CONFIG_NFC is not set
# CONFIG_INPUT_FPC1020 is not set
# CONFIG_QSEECOM is not set

# --- networking beyond what AF_MSM_IPC and USB RNDIS (dev telnet) need
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_L2TP is not set
# CONFIG_PPP is not set
# CONFIG_RMNET_DATA is not set
# IPA stays: the modem does a QMI handshake with the IPA driver once it is up.

# --- host-side USB and HID zoo
# CONFIG_UHID is not set
# CONFIG_USB_HIDDEV is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_VIDEO_CLASS is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_USB_GADGET_DEBUG_FS is not set

# --- runtime debug/trace overhead
# CONFIG_MSM_RTB is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TIMER_STATS is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_MSM_SMD_DEBUG is not set
# CONFIG_MSM_OCMEM_DEBUG is not set
# CONFIG_MMC_PERF_PROFILING is not set
# CONFIG_MMC_TEST is not set
# CONFIG_MMC_BLOCK_TEST is not set
# CONFIG_DEBUG_INFO is not set
# LK appends slub_debug=FZP (poison + redzone on every allocation); without
# SLUB_DEBUG compiled in, the kernel ignores it.
# CONFIG_SLUB_DEBUG is not set
